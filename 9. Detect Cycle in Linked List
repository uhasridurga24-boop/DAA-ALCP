#include <iostream>

using namespace std;
struct Node {
    int data;
    Node* next;
    Node(int val) : data(val), next(nullptr) {}
};
bool detectCycle(Node* head) {
    Node* slow = head;
    Node* fast = head;

    while (fast != nullptr && fast->next != nullptr) {
        slow = slow->next;         
        fast = fast->next->next;   

        if (slow == fast) {
            return true; 
        }
    }
    return false; // No cycle
}

int main() {
    Node* head = new Node(10);
    head->next = new Node(20);
    head->next->next = new Node(30);
    head->next->next->next = new Node(40);

    cout << boolalpha; 
    cout << "Initial list (No cycle): " << detectCycle(head) << endl;

    head->next->next->next->next = head->next;

    cout << "Altered list (Cycle introduced): " << detectCycle(head) << endl;

    return 0;
}
