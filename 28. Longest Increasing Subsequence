#include <iostream>
#include <vector>
#include <algorithm>

class Solution {
public:
    int lengthOfLIS(std::vector<int>& nums) {
        std::vector<int> tails;

        for (int x : nums) {
            auto it = std::lower_bound(tails.begin(), tails.end(), x);

            if (it == tails.end()) {
                tails.push_back(x);
            } else {
                *it = x;
            }
        }

        return tails.size();
    }
};

int main() {
    Solution sol;
    std::vector<int> nums = {10, 9, 2, 5, 3, 7, 101, 18};

    std::cout << "LIS length: " << sol.lengthOfLIS(nums) << std::endl; 

    return 0;
}
