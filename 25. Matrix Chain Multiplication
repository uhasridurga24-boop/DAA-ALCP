#include <iostream>
#include <vector>
#include <climits>
#include <algorithm>

class Solution {
public:
    int matrixMultiplication(const std::vector<int>& arr) {
        int n = arr.size();
      
        std::vector<std::vector<int>> dp(n, std::vector<int>(n, 0));
        for (int len = 2; len < n; ++len) {
            for (int i = 1; i < n - len + 1; ++i) {
                int j = i + len - 1;
                dp[i][j] = INT_MAX;
                for (int k = i; k < j; ++k) {
                    int cost = dp[i][k] + dp[k + 1][j] + (arr[i - 1] * arr[k] * arr[j]);
                    dp[i][j] = std::min(dp[i][j], cost);
                }
            }
        }

        return dp[1][n - 1];
    }
};

int main() {
    Solution sol;
    std::vector<int> arr = {10, 30, 5, 60};

    std::cout << "Minimum scalar multiplications: " 
              << sol.matrixMultiplication(arr) << std::endl; // Output: 4500

    return 0;
}
