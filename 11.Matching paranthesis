#include <iostream>
#include <stack>
using namespace std;

int main() {
    string s = "{[()]}";

    stack<char> st;

    for (char ch : s) {

        if (ch == '(' || ch == '{' || ch == '[')
            st.push(ch);

        else {

            if (st.empty()) {
                cout << "Invalid";
                return 0;
            }

            if ((ch == ')' && st.top() == '(') ||
                (ch == '}' && st.top() == '{') ||
                (ch == ']' && st.top() == '['))
                st.pop();
            else {
                cout << "Invalid";
                return 0;
            }
        }
    }

    if (st.empty())
        cout << "Valid";
    else
        cout << "Invalid";

    return 0;
}
