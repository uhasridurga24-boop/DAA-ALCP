class Solution {
    struct TrieNode {
        TrieNode* children[26];
        std::string word;
        TrieNode() {
            word = "";
            for (int i = 0; i < 26; ++i) {
                children[i] = nullptr;
            }
        }
    };

    void insertTrie(TrieNode* root, const std::string& word) {
        TrieNode* curr = root;
        for (char c : word) {
            int idx = c - 'a';
            if (!curr->children[idx]) {
                curr->children[idx] = new TrieNode();
            }
            curr = curr->children[idx];
        }
        curr->word = word;
    }

    void dfs(std::vector<std::vector<char>>& board, int r, int c, TrieNode* node, std::vector<std::string>& result) {
        char ch = board[r][c];
        int idx = ch - 'a';

        if (ch == '#' || !node->children[idx]) {
            return;
        }

        node = node->children[idx];
        if (!node->word.empty()) {
            result.push_back(node->word);
            node->word = ""; 
        }

        board[r][c] = '#'; 

        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};

        for (int i = 0; i < 4; ++i) {
            int nr = r + dr[i];
            int nc = c + dc[i];

            if (nr >= 0 && nr < board.size() && nc >= 0 && nc < board[0].size() && board[nr][nc] != '#') {
                dfs(board, nr, nc, node, result);
            }
        }

        board[r][c] = ch; // Backtrack
    }

public:
    std::vector<std::string> findWords(std::vector<std::vector<char>>& board, std::vector<std::string>& words) {
        TrieNode* root = new TrieNode();
        for (const std::string& word : words) {
            insertTrie(root, word);
        }

        std::vector<std::string> result;
        int m = board.size();
        int n = board[0].size();

        for (int i = 0; i < m; ++i) {
            for (int j = 0; j < n; ++j) {
                dfs(board, i, j, root, result);
            }
        }

        return result;
    }
};
