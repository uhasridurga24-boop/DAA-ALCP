class Solution {
    int rows[9] = {0};
    int cols[9] = {0};
    int boxes[9] = {0};

public:
    void solveSudoku(std::vector<std::vector<char>>& board) {
        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                if (board[r][c] != '.') {
                    int val = board[r][c] - '1';
                    int boxIdx = (r / 3) * 3 + (c / 3);
                    rows[r] |= (1 << val);
                    cols[c] |= (1 << val);
                    boxes[boxIdx] |= (1 << val);
                }
            }
        }
        solve(board, 0, 0);
    }

private:
    bool solve(std::vector<std::vector<char>>& board, int r, int c) {
        if (r == 9) return true;
        if (c == 9) return solve(board, r + 1, 0);
        if (board[r][c] != '.') return solve(board, r, c + 1);
        int boxIdx = (r / 3) * 3 + (c / 3);
        for (int val = 0; val < 9; ++val) {
            int mask = 1 << val;
            if (!(rows[r] & mask) && !(cols[c] & mask) && !(boxes[boxIdx] & mask)) {
                board[r][c] = '1' + val;
                rows[r] |= mask;
                cols[c] |= mask;
                boxes[boxIdx] |= mask;
                if (solve(board, r, c + 1)) return true;
                board[r][c] = '.';
                rows[r] &= ~mask;
                cols[c] &= ~mask;
                boxes[boxIdx] &= ~mask;
            }
        }
        return false;
    }
};
